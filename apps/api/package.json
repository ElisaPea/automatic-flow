{
  "name": "@af/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch-path=src -r @swc-node/register src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local -r @swc-node/register scripts/migrate.ts"
  },
  "dependencies": {
    "@af/schemas": "workspace:*",
    "@clerk/express": "^2.1.93",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "typedi": "^0.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@af/eslint-config": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.13.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
