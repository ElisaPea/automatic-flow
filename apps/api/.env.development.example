# ─── API · DESARROLLO ──────────────────────────────────────────────
# Copia a apps/api/.env.local y rellena los secretos (<...>).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Supabase (proyecto cnvimjwjonwcqllbqthe · eu-west-1).
# Dashboard → Connect → "Session pooler" (puerto 5432, compatible IPv4).
DATABASE_URL=postgresql://postgres.cnvimjwjonwcqllbqthe:<DB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5
DB_SSL=true
DB_STATEMENT_TIMEOUT_MS=8000

# Clerk (app_3MKUJK4usfkfPUgOCVXb0Tctu6r · instancia development)
CLERK_PUBLISHABLE_KEY=pk_test_c3RlYWR5LW9yeXgtNDMxMi5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_<CLERK_SECRET_KEY>

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
REQUEST_TIMEOUT_MS=9000
BODY_LIMIT=100kb
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_S=60

# memory | upstash | none
CACHE_DRIVER=memory
CACHE_MEMORY_MAX_ENTRIES=1000
