# ─── API · PRODUCCIÓN ──────────────────────────────────────────────
# NO se usa como archivo: configura estas variables en Vercel (o en la plataforma destino).
NODE_ENV=production
LOG_LEVEL=info

# Vercel Functions → "Transaction pooler" (puerto 6543) + pool pequeño por instancia.
# Instancia clásica   → "Session pooler" (5432) o conexión directa + DB_POOL_MAX=10..20.
DATABASE_URL=postgresql://postgres.cnvimjwjonwcqllbqthe:<DB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=2
DB_SSL=true
DB_STATEMENT_TIMEOUT_MS=8000

# Clerk · instancia production (crear en el dashboard de Clerk)
CLERK_PUBLISHABLE_KEY=pk_live_<CLERK_PUBLISHABLE_KEY>
CLERK_SECRET_KEY=sk_live_<CLERK_SECRET_KEY>

CORS_ORIGINS=https://<tu-dominio-web>
# Menor que maxDuration de la función (10s en vercel.json)
REQUEST_TIMEOUT_MS=9000
BODY_LIMIT=100kb
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_S=60

# En serverless "memory" es por instancia; usa upstash para caché/rate-limit globales.
CACHE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_TOKEN>
